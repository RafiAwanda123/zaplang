# ── ZAP ──────────────────────────────────────────────────────────────────────
# Base URL ZAP daemon (hanya 127.0.0.1 yang diizinkan - lihat scope-guardrails)
ZAP_BASE=http://127.0.0.1:8080

# API key ZAP (wajib diisi; dikirim via header X-ZAP-Api-Key, BUKAN query string)
ZAP_API_KEY=your-zap-api-key-here

# Host target yang diizinkan di-scan, pisahkan dengan koma
# Contoh: ALLOWED_HOSTS=target.local,staging.example.com
ALLOWED_HOSTS=target.local

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://zaplang:password@localhost:5432/zaplang

# ── Ollama / RAG ─────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
RAG_API_KEY=your-rag-api-key-here
RAG_MAX_DOC_BYTES=200000
RAG_SCORE_THRESHOLD=0.25
RAG_TOP_K=4

# ── LLM (OpenRouter) ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
